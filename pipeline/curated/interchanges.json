    "sameOperatorGateS": 120,
    "$sameOperatorNote": "Walking between two separate stations of one operator; no new ticket needed mid-journey.",
    "samePaidArea": false,
    "$samePaidAreaNote": "All links here join separate stations, so none is inside a single paid area."
  },
